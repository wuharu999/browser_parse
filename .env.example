# Copy to .env locally. Never commit populated credentials.
# Commands below use: uv run --env-file .env ...
ROBOT_WORKER_TOKEN=replace-with-a-long-random-worker-secret
JOB_DB=data/jobs.sqlite3
JOB_UPLOAD_DIR=data/uploads
JOB_DAILY_LIMIT_USD=10
JOB_ESTIMATE_USD=5
JOB_MAX_RUNNING=2
JOB_MAX_PENDING=20
JOB_MAX_RUNTIME_SECONDS=1800
JOB_CLAIM_TTL_SECONDS=1800
# ECS per-job admission maxima, not summed resources across hosts.
JOB_POOL_CPU_MILLI=4000
JOB_POOL_MEMORY_MB=8192
JOB_POOL_DISK_MB=32768
# Comma-separated browser origins, only if serving UI separately from API.
JOB_ALLOWED_ORIGINS=

# Required on each Docker worker host. Give the two workers distinct IDs.
ROBOT_API_URL=http://47.239.12.206:8000
ROBOT_WORKER_ID=worker-a
ROBOT_WORKER_PARALLEL=1
ROBOT_DOCKER_IMAGE=registry.example.com/robot-log-analysis@sha256:replace-with-built-image-digest
ROBOT_DOCKER_NETWORK=robot-analysis-jobs
ROBOT_EGRESS_PROXY_URL=http://robot-egress-proxy:3128
# Per-job maxima on this machine; the worker also checks actual available resources.
ROBOT_WORKER_CPU_MILLI=4000
ROBOT_WORKER_MEMORY_MB=8192
ROBOT_WORKER_DISK_MB=24576
ROBOT_DOCKER_DATA_DIR=/var/lib/docker
# Leave one CPU and 1 GiB RAM for host services. Disk free-space reserve is configurable.
# Disk is monitored and jobs stop over the threshold; this is not a hard disk quota.
ROBOT_HOST_DISK_RESERVE_MB=8192
ROBOT_JOB_TIMEOUT_SECONDS=1800
# DeepSeek now supports Codex's Responses API. A DeepSeek key is NOT a GitHub key.
ROBOT_CODEX_MODEL=deepseek-v4-flash-vision-exp
ROBOT_CODEX_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
ROBOT_CODEX_PROVIDER_URL=https://api.deepseek.com
# Optional host-side pre-execution security guard configuration.
# Defaults to ROBOT_CODEX_* settings when omitted; set ROBOT_GUARD_ENABLED=0 to disable.
# ROBOT_GUARD_ENABLED=1
# ROBOT_GUARD_MODEL=deepseek-v4-flash
# ROBOT_GUARD_PROVIDER_URL=https://api.deepseek.com
# ROBOT_GUARD_API_KEY=

# Defaults to this checkout's knowledge/wiki when present.
ROBOT_WIKI_DIR=
