# Copy to .env locally. Never commit populated credentials.
# Commands below use: uv run --env-file .env ...
ROBOT_WORKER_TOKEN=replace-with-a-long-random-worker-secret
JOB_DB=data/jobs.sqlite3
JOB_UPLOAD_DIR=data/uploads
JOB_DAILY_LIMIT_USD=10
JOB_ESTIMATE_USD=5
JOB_MAX_RUNNING=2
JOB_MAX_PENDING=20
JOB_MAX_RUNTIME_SECONDS=1800
JOB_CLAIM_TTL_SECONDS=1800
# Comma-separated browser origins, only if serving UI separately from API.
JOB_ALLOWED_ORIGINS=

# Required only for real sandbox execution. These are NOT host execution settings.
ROBOT_API_URL=http://127.0.0.1:8000
CUBE_API_URL=
CUBE_API_KEY=
CUBE_TEMPLATE_ID=
CUBE_PROXY_NODE_IP=
ROBOT_WORKER_PARALLEL=2
ROBOT_JOB_TIMEOUT_SECONDS=1800
ROBOT_CODEX_MODEL=gpt-5.6-luna
ROBOT_CODEX_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
# Optional Responses-compatible provider endpoint for a future model/provider.
ROBOT_CODEX_PROVIDER_URL=
# Defaults to this checkout's knowledge/wiki when present.
ROBOT_WIKI_DIR=
