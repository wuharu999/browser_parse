# Copy to .env locally. Never commit populated credentials.
# Commands below use: uv run --env-file .env ...
ROBOT_WORKER_TOKEN=replace-with-a-long-random-worker-secret
JOB_DB=data/jobs.sqlite3
JOB_UPLOAD_DIR=data/uploads
JOB_DAILY_LIMIT_USD=10
JOB_ESTIMATE_USD=5
JOB_MAX_RUNNING=2
JOB_MAX_PENDING=20
JOB_MAX_RUNTIME_SECONDS=1800
JOB_CLAIM_TTL_SECONDS=1800
# Shared job pool on the planned 8-core/16-GiB worker (leaves OS/Cube headroom).
JOB_POOL_CPU_MILLI=4000
JOB_POOL_MEMORY_MB=8192
JOB_POOL_DISK_MB=32768
# Comma-separated browser origins, only if serving UI separately from API.
JOB_ALLOWED_ORIGINS=

# Required only for real sandbox execution. These are NOT host execution settings.
ROBOT_API_URL=http://127.0.0.1:8000
CUBE_API_URL=
CUBE_API_KEY=
CUBE_TEMPLATE_ID=
# Required for auto-sized jobs; templates must match backend/resources.py.
CUBE_TEMPLATES_JSON='{"small":"replace-small-template-id","standard":"replace-standard-template-id","large":"replace-large-template-id"}'
CUBE_PROXY_NODE_IP=
CUBE_PROXY_PORT_HTTP=
ROBOT_WORKER_PARALLEL=2
ROBOT_JOB_TIMEOUT_SECONDS=1800
# DeepSeek now supports Codex's Responses API. A DeepSeek key is NOT a GitHub key.
ROBOT_CODEX_MODEL=deepseek-v4-flash-vision-exp
ROBOT_CODEX_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
ROBOT_CODEX_PROVIDER_URL=https://api.deepseek.com
# deepseek-flash is the current DeepSeek vision model. deepseek-v4-flash-vision-exp is a retired compatible alias.
# To restore OpenAI: use gpt-5.6-luna, OPENAI_API_KEY, and an empty provider URL.
# Qwen Chat Completions endpoints cannot simply replace this Responses URL.
# Defaults to this checkout's knowledge/wiki when present.
ROBOT_WIKI_DIR=
